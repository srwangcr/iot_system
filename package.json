{
  "name": "iot-club-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Modular IoT club management backend",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-manifests.cjs",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.10.2",
    "pg-mem": "^3.0.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
