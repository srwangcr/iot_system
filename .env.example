# Puerto de la API y del frontend (docker compose)
PORT=3000
API_PORT=3000
FRONTEND_PORT=8080

# URL que usará el navegador para llegar a la API
VITE_API_URL=http://localhost:3000
# Con Cloudflare Tunnel (mismo hostname, regla /api): VITE_API_URL=https://iot.tudominio.com

# Origen permitido por CORS (el frontend)
FRONTEND_ORIGIN=http://localhost:8080

# Cloudflare Tunnel (opcional). Si publicas la app con un túnel, usa la URL
# pública del frontend aquí y en VITE_API_URL, y pega el token del túnel.
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL
DATABASE_URL=postgresql://iot:change-me-in-production@postgres:5432/iot_club
POSTGRES_PASSWORD=change-me-in-production

# Cuentas de la API. Cambia contraseñas y tokens antes de desplegar.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me-in-production
AUTH_ADMIN_TOKEN=replace-admin-token
AUTH_MEMBER_USERNAME=member
AUTH_MEMBER_PASSWORD=change-me-in-production
AUTH_MEMBER_TOKEN=replace-member-token
